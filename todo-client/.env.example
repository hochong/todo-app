# Copy to .env.local and fill in before social sign-in will work.
# VITE_API_URL=http://localhost:5000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Add http://localhost:5173 (and your production origin) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, IDs & Profiles -> Identifiers -> Services ID.
# Requires a paid Apple Developer Program membership and a verified HTTPS domain + return URL
# registered under that Services ID; Sign in with Apple JS will not run on http://localhost.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
